NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://erf:erf_dev_password@localhost:5432/erf
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://erf:erf_dev_password@localhost:5672
LOG_LEVEL=info
AUTH_JWT_SECRET=replace-with-a-minimum-32-character-secret
DATA_ENCRYPTION_SECRET=replace-with-a-minimum-32-character-secret
MFS_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
QR_SIGNING_KEY_ID=dev-2026-01
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://identity.example.gov.bd
OIDC_AUDIENCE=erf-api
SMS_GATEWAY_URL=https://sms-gateway.example.gov.bd/messages
SMS_GATEWAY_TOKEN=replace-with-sms-gateway-token
SMS_WEBHOOK_SECRET=replace-with-sms-webhook-secret

# Web PWA build-time variables (apps/web). Leave unset for local development:
# the app falls back to the manual development bearer-token field.
VITE_API_URL=http://localhost:3000
VITE_OIDC_ISSUER_URL=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPE=openid profile
