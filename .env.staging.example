NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://replace-user:replace-password@postgres:5432/erf
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://replace-user:replace-password@rabbitmq:5672
AUTH_JWT_SECRET=replace-with-a-staging-secret-at-least-32-characters
DATA_ENCRYPTION_SECRET=replace-with-a-staging-secret-at-least-32-characters
MFS_WEBHOOK_SECRET=replace-with-the-provider-webhook-secret-at-least-32
QR_SIGNING_KEY_ID=staging-key-from-kms
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://identity.example.gov.bd
OIDC_AUDIENCE=erf-api
SMS_GATEWAY_URL=https://sms-gateway.example.gov.bd/messages
SMS_GATEWAY_TOKEN=replace-with-sms-gateway-token
SMS_WEBHOOK_SECRET=replace-with-sms-webhook-secret
POSTGRES_DB=erf
POSTGRES_USER=replace-user
POSTGRES_PASSWORD=replace-password
RABBITMQ_USER=replace-user
RABBITMQ_PASSWORD=replace-password
